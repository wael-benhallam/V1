{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/radar", "destination": "/" },
    { "source": "/merci", "destination": "/merci" }
  ],
  "headers": [
    { "source": "/merci(.html)?", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
